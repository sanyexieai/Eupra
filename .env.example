# Example only. Export these in your shell; the application does not auto-load .env.
# Keep local development bound to loopback.
EUPRA_BIND=127.0.0.1:8787
EUPRA_DATABASE=eupra.sqlite3
# unavailable (safe default), demo (explicit template-only test), or http.
EUPRA_PROVIDER=unavailable
# HTTPS engine service under your control, implementing backend provider contract.
# EUPRA_ENGINE_URL=https://your-authorized-engine.example/v1/generate
# EUPRA_ENGINE_KEY=configure-securely-outside-source-control
# complete (default) or staged; both require a real server implementing PROVIDER.md.
# EUPRA_ENGINE_MODE=staged
# For HTTPS deployment only:
# EUPRA_SECURE_COOKIE=1

# Isolated loopback-only development review of OWN demo text, never production approval.
# EUPRA_LOCAL_REVIEW=1
# Optional single-origin compiled frontend directory:
# EUPRA_WEB_DIST=/absolute/path/to/frontend/dist
